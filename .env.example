# --- Supabase Postgres (Project Settings → Database) ---
# Transaction pooler (PgBouncer), port 6543 — use for Prisma at runtime (Vercel serverless)
# Append: ?pgbouncer=true  (Prisma docs: required for pooler)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (migrations) — "Session" / URI in Supabase, host db.*.supabase.co :5432
# (If omitted, `npm run build` copies DATABASE_URL so Prisma can run; a separate direct URL is still recommended for migrations on Supabase.)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Copy to .env locally. In Vercel: Project → Settings → Environment Variables (add both).

# --- Z AI (z-ai-web-dev-sdk) — optional: use for local dev instead of .z-ai-config
# If Z_AI_BASE_URL and Z_AI_API_KEY are set, they override .z-ai-config. Required for typical Vercel deploys.
# Z_AI_BASE_URL="https://your-api.example.com"
# Z_AI_API_KEY="your-key"
# Z_AI_MODEL="deepseek-ai/deepseek-v4-pro"
# Z_AI_CHAT_ID=""
# Z_AI_USER_ID=""
# Z_AI_TOKEN=""

# NVIDIA (OpenAI-compatible) testing — `src/lib/ai-completions.ts` uses plain fetch + chat_template_kwargs
# Z_AI_BASE_URL="https://integrate.api.nvidia.com/v1"
# Z_AI_API_KEY="nvapi-…"
# Z_AI_MODEL="deepseek-ai/deepseek-v4-pro"
# Z_AI_USE_OPENAI_COMPAT="1"   # optional: force OpenAI-style fetch (auto when URL contains nvidia.com)
# Z_AI_SKIP_CHAT_TEMPLATE_KWARGS="1"  # optional: omit chat_template_kwargs on the request

# See: agent-ctx/ai-api-configuration.md and agent-ctx/ai-api.config.json

# Required in production: a strong, random session-signing secret (32+ characters).
# Existing unsigned sessions are invalidated when this version is deployed.
# SESSION_SECRET="replace-with-a-cryptographically-random-secret"

# Optional: enable mission web search through the Z AI SDK.
# Leave disabled for NVIDIA/OpenAI-compatible chat-only endpoints.
# MISSION_WEB_SEARCH="1"

# Required for the daily retention cleanup job on Vercel. Use a different random
# 32+ character secret from SESSION_SECRET; Vercel sends it as Bearer auth.
# CRON_SECRET="replace-with-a-separate-cryptographically-random-secret"

# --- Email ---
# Unset (or "stub") only logs emails; nothing is sent. Use "resend" in production.
# EMAIL_PROVIDER="resend"
# RESEND_API_KEY="re_..."
# Sender; the domain must be verified in Resend. RESEND_FROM_EMAIL is also accepted.
# EMAIL_FROM="CosmoGov <support@cosmogov.com>"
# Public site address used to make links in emails clickable (default https://www.cosmogov.com).
# APP_URL="https://www.cosmogov.com"

# --- Community map ---
# Open-source basemap, no API key needed. Defaults to OpenFreeMap's "positron" style
# (OpenStreetMap data). Any MapLibre style URL works, e.g. a self-hosted OpenFreeMap or Protomaps.
# NEXT_PUBLIC_MAP_STYLE_URL="https://tiles.openfreemap.org/styles/positron"
